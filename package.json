{
  "name": "workout-plan-v3",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun vite dev",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "generate-routes": "tsr generate",
