# MongoDB connection string. Local Docker default:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=workout_plan_v3

# Better Auth: a random secret of 32+ characters, and the URL the app is served from.
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
# Where the app is reached. In production the deployed address, like https://plates.vercel.app, no trailing slash.
BETTER_AUTH_URL=http://localhost:3000
# The password door (sign in with email or username, Create account) is open only where this is true.
# Leave it unset in production: Google is the only way in there, which keeps sign-up spam out.
AUTH_PASSWORD=true

# Optional. Sign in with Google: create OAuth credentials in Google Cloud and add
# http://localhost:3000/api/auth/callback/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. A copy of feedback is emailed through Resend when a key and FEEDBACK_TO are set.
RESEND_API_KEY=
# The sender. Resend's test sender can only deliver to the email address of your own Resend account,
# which is enough for the feedback copy; a verified domain lets it reach anyone.
MAIL_FROM=Plates <onboarding@resend.dev>

# Optional: where feedback sent from the app is mailed. Without it, feedback only lands in the database.
FEEDBACK_TO=
